{
  "manifest_version": 3,
  "name": "e-Fatura QR Reader",
  "version": "0.1.0",
  "description": "Select the QR code on the current page and see the e-Fatura fields in a table.",
  "minimum_chrome_version": "112",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Read e-Fatura QR code" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Q" } }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
