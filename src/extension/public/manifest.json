{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "pt_PT",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "112",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icon-16.png", "24": "icon-24.png", "32": "icon-32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Q" } }
  },
  "icons": { "16": "icon-16.png", "24": "icon-24.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
