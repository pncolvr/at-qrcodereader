{
  "name": "at-qr-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: select a region of the current tab, decode an AT QR code and show its fields in a table.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build.mjs extension",
    "build:page": "node scripts/build.mjs page",
    "build:preview": "node scripts/build.mjs preview",
    "watch": "node scripts/build.mjs extension --watch",
    "package:extension": "npm run build:extension && node scripts/extension-release.mjs package",
    "version:extension": "node scripts/extension-release.mjs version",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
