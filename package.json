{
  "name": "efatura-qr-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: select a region of the current tab, decode an e-Fatura QR code and show its fields in a table.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
